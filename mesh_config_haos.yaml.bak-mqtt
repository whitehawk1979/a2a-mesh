mesh:
  capabilities:
  - a2a_messaging
  - file_transfer
  - p2p_transport
  - pg_transport
  - ssh_tunnel_transport
  - health_monitor
  - registry
  - dashboard
  discovery:
    mdns:
      enabled: false
    static_only: true
  health_port: 8650
  node_name: tor
  topology:
    auto_approve_known_agents: true
    max_children: 20
    max_depth: 5
    max_routers: 8
    node_role: router
    routing_mode: hybrid
    trust_center_enabled: true
  transport_priority:
  - p2p
  - ssh_tunnel
  - pg_notify
  - http
  transports:
    p2p:
      advertise_host: 100.74.221.46
      listen_port: 8645
      static_nodes:
      - host: 192.168.1.8
        name: nova
        port: 8645
      - host: 192.168.1.30
        name: morzsa
        port: 8645
      - host: 192.168.1.100
        name: runa
        port: 8645
      tls_ca: /config/a2a-mesh/certs/a2a-mesh-ca.crt
      tls_cert: /config/a2a-mesh/certs/tor.crt
      tls_enabled: true
      tls_key: /config/a2a-mesh/certs/tor.key
    pg_notify:
      dbname: agent_memory
      host: 192.168.1.30
      listen: true
      password: vault:MESH/PG_PASSWORD
      port: 5432
      user: nova
    ssh_tunnel:
      connect_timeout: 15
      default_identity_file: /config/.ssh/id_ed25519
      default_ssh_user: ''
      enabled: true
      keepalive_interval: 30
      local_port_start: 9200
      max_retries: 3
      peers:
        morzsa:
          connect_timeout: 60
          identity_file: /config/.ssh/id_ed25519
          remote_port: 8645
          ssh_host: 192.168.1.30
          ssh_port: 22
          ssh_user: openclaw
        nova:
          connect_timeout: 60
          identity_file: /config/.ssh/id_ed25519
          remote_port: 8645
          ssh_host: 192.168.1.8
          ssh_port: 2230
          ssh_user: zsolt
        runa:
          connect_timeout: 60
          identity_file: /config/.ssh/id_ed25519
          remote_port: 8645
          ssh_host: 192.168.1.100
          ssh_port: 22
          ssh_user: zsolt
        mano:
          connect_timeout: 60
          identity_file: /config/.ssh/id_ed25519
          remote_port: 8645
          ssh_host: 192.168.1.43
          ssh_port: 2230
          ssh_user: root
          forward_host: 127.0.0.1
      advertised_forward_host: 172.30.33.13
      reconnect_interval: 10
  wake_agent_on_message: true
  ollama_url: http://100.75.253.52:11434
  webhook_port: 8766
